FROM docker.io/library/node:26.13.0-trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git jq ripgrep \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/node/.pi/agent \
  && chmod 700 /home/node/.pi \
  && chown -R node:node /home/node/.pi

RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent \
  && npm cache clean --force

ENV PI_CODING_AGENT_DIR=/home/node/.pi/agent
ENV PI_SKIP_VERSION_CHECK=1
ENV PI_TELEMETRY=0

ENV PI_APPEND_SYSTEM_PROMPT_FILE=/opt/pi/APPEND_SYSTEM_PROMPT.txt
COPY <<'EOF' ${PI_APPEND_SYSTEM_PROMPT_FILE}
You are working inside a hardened Podman container as non-root `node` user (no sudo/apt).
- Root FS is read-only
- Writable: cwd (bind-mounted from host), /tmp, /home/node/.pi/agent
- Installed tools: bash, git, jq, node/npm, ripgrep (rg)
EOF

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER node
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
